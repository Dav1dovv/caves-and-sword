extends Resource
class_name CreatureSpawnEntry

# ═══════════════════════════════════════════════════════════════════════════
#  CreatureSpawnEntry — один тип существа в таблице спавна биома
# ───────────────────────────────────────────────────────────────────────────
#  Создаётся как отдельный .tres файл, например:
#  res://data/creatures/spawn_entries/pchela_forest.tres
# ═══════════════════════════════════════════════════════════════════════════

## Сцена существа (должна быть в группе "Ennemy" при спавне — это делает
## CreatureSpawnManager автоматически)
@export var creature_scene: PackedScene

## Относительный вес при случайном выборе (больше — чаще встречается)
@export var weight: float = 1.0

## Тир существа. По балансу из документа: Лес 0-1, Север/Пустыня 2,
## Шахта/глубокие 2-3, Бездна 4
@export_range(0, 4, 1) var tier: int = 0

## Спавнить только под землёй (шахта/пещеры)
@export var underground_only: bool = false

## Минимальный уровень заражения локации (0–3), при котором существо может появиться.
## 0 — не зависит от заражения
@export_range(0, 3, 1) var min_corruption: int = 0

## Существа предпочитают спавниться группой (напр. Тапики, Ноксы)
@export var group_size_min: int = 1
@export var group_size_max: int = 1

# ═══════════════════════════════════════════════════════════════════════════
#  Условия появления: время суток и погода
#  По умолчанию включено ВСЁ (существо появляется в любое время/погоду).
#  В инспекторе просто сними галочки с ненужных вариантов, чтобы ограничить.
# ═══════════════════════════════════════════════════════════════════════════

## Время суток, когда существо может появиться (соответствует DayNightCycle.Phase).
## Можно оставить все галочки — появляется всегда, либо выбрать конкретные фазы.
@export_flags("День", "Полдень", "Ночь") var allowed_phases: int = 7

## Погодные условия, при которых существо может появиться.
## Можно оставить все галочки — появляется в любую погоду, либо выбрать конкретные.
@export_flags("Ясно", "Дождь", "Ливень", "Туман", "Песчаная буря", "Ясная ночь") var allowed_weather: int = 63

## Строковый тип погоды (как в WeatherSystem) -> бит в allowed_weather
const _WEATHER_BITS := {
	"clear":       1,
	"rain":        2,
	"heavy_rain":  4,
	"fog":         8,
	"sandstorm":   16,
	"clear_night": 32,
}


## true, если существо разрешено появляться в данную фазу дня (DayNightCycle.Phase)
func can_spawn_in_phase(phase: int) -> bool:
	return (allowed_phases & (1 << phase)) != 0


## true, если существо разрешено появляться в данную погоду (строка из WeatherSystem,
## например "rain", "clear", "fog"...). Неизвестный/пустой тип погоды не блокирует спавн.
func can_spawn_in_weather(weather_type: String) -> bool:
	var bit: int = _WEATHER_BITS.get(weather_type, 0)
	if bit == 0:
		return true
	return (allowed_weather & bit) != 0
